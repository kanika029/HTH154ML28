# ============================================
# SMARTSENSE AI - Git Ignore
# ============================================

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
*.egg
*.egg-info/
dist/
build/
.eggs/

# ----------------------------
# Environment / Secrets
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# Database
# ----------------------------
*.db
*.sqlite
*.sqlite3

# ----------------------------
# Node / React / Vite
# ----------------------------
node_modules/
frontend/node_modules/

# Vite
frontend/dist/
dist/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------
# Build / Cache
# ----------------------------
.cache/
.parcel-cache/
.vite/
.eslintcache

# ----------------------------
# IDE / Editors
# ----------------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------------
# OS Files
# ----------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ----------------------------
# Python / ML Cache
# ----------------------------
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----------------------------
# Jupyter
# ----------------------------
.ipynb_checkpoints/

# ----------------------------
# Temporary Files
# ----------------------------
*.tmp
*.temp
*.bak

